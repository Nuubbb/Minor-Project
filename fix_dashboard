"""Replace the entire <script>...</script> block in dashboard.html with a clean version."""

t = open('templates/dashboard.html', encoding='utf-8').read()

# Find and replace everything between <script> and </script>
start = t.index('<script>')
end = t.index('</script>') + len('</script>')

clean_script = """<script>
        // Live date
        (function() {
            var d = new Date();
            document.getElementById('current-date').textContent =
                d.toLocaleDateString('en-US', { weekday: 'short', year: 'numeric', month: 'short', day: 'numeric' });
        })();

        // Feed timestamp
        var feedTime = document.getElementById('feed-time');
        if (feedTime) setInterval(function() {
            feedTime.textContent = new Date().toLocaleTimeString('en-US', { hour12: false });
        }, 1000);

        // Session uptime
        var loginTime = new Date("{{ session.get('login_time', '') }}");
        function updateUptime() {
            var diff = Math.floor((Date.now() - loginTime) / 1000);
            var h = Math.floor(diff / 3600), m = Math.floor((diff % 3600) / 60);
            document.getElementById('stat-uptime').textContent = h > 0 ? h + 'h ' + m + 'm' : m + 'm';
        }
        setInterval(updateUptime, 30000);
        updateUptime();

        // Alert stats: initial + auto-refresh every 3 seconds
        function updateAlertStats() {
            fetch("/get_alerts").then(function(r) { return r.text(); }).then(function(h) {
                document.getElementById('alerts-tbody').innerHTML = h;
                var total = 0, active = 0, dismissed = 0;
                var tmp = document.createElement('div');
                tmp.innerHTML = '<table>' + h + '</table>';
                tmp.querySelectorAll('tr').forEach(function(r) {
                    if (r.querySelector('td') && !r.querySelector('td[colspan]')) {
                        total++;
                        if (r.innerHTML.includes('Dismissed')) dismissed++;
                        else active++;
                    }
                });
                document.getElementById('stat-total').textContent = total;
                document.getElementById('stat-active').textContent = active;
                document.getElementById('stat-dismissed').textContent = dismissed;
            });
        }
        updateAlertStats();
        setInterval(updateAlertStats, 3000);

        // GPS Location
        (function() {
            var badge = document.getElementById('gps-badge');
            var text = document.getElementById('gps-text');
            if (!navigator.geolocation) {
                badge.className = 'gps-status denied';
                text.textContent = 'GPS: Not supported';
                return;
            }
            navigator.geolocation.getCurrentPosition(
                function(pos) {
                    fetch('/update_location', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ lat: pos.coords.latitude, lng: pos.coords.longitude })
                    }).then(function(r) {
                        if (r.ok) {
                            badge.className = 'gps-status active';
                            text.textContent = 'GPS: Active';
                        } else {
                            badge.className = 'gps-status denied';
                            text.textContent = 'GPS: Server error';
                        }
                    }).catch(function() {
                        badge.className = 'gps-status denied';
                        text.textContent = 'GPS: Send failed';
                    });
                },
                function(err) {
                    badge.className = 'gps-status denied';
                    text.textContent = err.code === 1 ? 'GPS: Denied' : 'GPS: Unavailable';
                },
                { enableHighAccuracy: true, timeout: 10000 }
            );
        })();

        // Charts
        {% if threat_stats %}
        var threatCtx = document.getElementById('threatChart').getContext('2d');
        var threatLabels = {{ threat_stats|map(attribute='alert_type')|list|tojson }};
        var threatData = {{ threat_stats|map(attribute='cnt')|list|tojson }};
        var colorMap = {
            'violence': '#dc2626', 'weapon-detected': '#f59e0b', 'weapon-seen': '#f59e0b',
            'weapon+violence': '#b91c1c', 'weapon-near-people': '#d97706',
            'gun-detected': '#f59e0b', 'knife-detected': '#d97706',
            'crowd-motion': '#0ea5e9', 'after-hours-crowd': '#0284c7',
            'loitering': '#7c3aed', 'intrusion': '#7c3aed'
        };
        var bgColors = threatLabels.map(function(l) { return colorMap[l.toLowerCase()] || '#2563eb'; });
        new Chart(threatCtx, {
            type: 'doughnut',
            data: {
                labels: threatLabels.map(function(l) { return l.replace(/-/g, ' ').replace(/\\b\\w/g, function(c) { return c.toUpperCase(); }); }),
                datasets: [{ data: threatData, backgroundColor: bgColors, borderWidth: 0, hoverOffset: 8 }]
            },
            options: {
                responsive: true, cutout: '65%',
                plugins: { legend: { position: 'bottom', labels: { padding: 16, usePointStyle: true, pointStyle: 'circle', font: { size: 12, family: 'Inter', weight: '600' } } } }
            }
        });
        {% endif %}

        {% if daily_stats %}
        var dailyCtx = document.getElementById('dailyChart').getContext('2d');
        new Chart(dailyCtx, {
            type: 'bar',
            data: {
                labels: {{ daily_stats|map(attribute='day')|list|tojson }}.map(function(d) {
                    var dt = new Date(d);
                    return dt.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
                }),
                datasets: [{
                    label: 'Alerts',
                    data: {{ daily_stats|map(attribute='cnt')|list|tojson }},
                    backgroundColor: 'rgba(37, 99, 235, 0.15)',
                    borderColor: '#2563eb', borderWidth: 2, borderRadius: 8,
                    hoverBackgroundColor: 'rgba(37, 99, 235, 0.3)'
                }]
            },
            options: {
                responsive: true,
                scales: {
                    y: { beginAtZero: true, ticks: { stepSize: 1, font: { family: 'Inter' } }, grid: { color: '#f1f5f9' } },
                    x: { grid: { display: false }, ticks: { font: { family: 'Inter', weight: '600' } } }
                },
                plugins: { legend: { display: false } }
            }
        });
        {% endif %}
    </script>"""

t = t[:start] + clean_script
open('templates/dashboard.html', 'w', encoding='utf-8').write(t)
print("Done! Full script section replaced.")